{
  "name": "baton",
  "version": "0.8.0",
  "description": "Park pending work from Claude Code sessions as tasks, linked to sessions and GitHub PRs.",
  "main": "src/main.js",
  "bin": {
    "baton": "bin/baton.js"
  },
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "install-skill": "node bin/baton.js install-skill",
    "dist": "electron-builder --mac dmg --arm64",
    "postdist": "rm -rf dist/mac-arm64"
  },
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "productName": "Baton",
  "build": {
    "appId": "app.baton.tasks",
    "productName": "Baton",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "lib/**",
      "bin/**",
      "skill/**",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "bin/**",
      "lib/**",
      "skill/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "artifactName": "Baton-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Baton"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeCliInspectArguments": false,
      "enableNodeOptionsEnvironmentVariable": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Baton-windows-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Baton"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "executableName": "baton",
      "maintainer": "Baton <noras-salman@users.noreply.github.com>",
      "synopsis": "Tasks, PRs and Claude Code sessions in one place",
      "artifactName": "Baton-linux-${arch}.${ext}"
    }
  },
  "author": {
    "name": "Baton",
    "email": "noras-salman@users.noreply.github.com"
  },
  "homepage": "https://noras-salman.github.io/baton/",
  "repository": {
    "type": "git",
    "url": "https://github.com/noras-salman/baton.git"
  }
}
